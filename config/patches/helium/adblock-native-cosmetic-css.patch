+        let mut hasher = DefaultHasher::new();
+        css.hash(&mut hasher);
+        Self {
+            id: format!("{:016x}", hasher.finish()),
+            css,
+            selectors: ordered.into_iter().collect(),
+        }
+    }
+
+    fn without(&self, exceptions: &HashSet<String>) -> Option<String> {
+        if exceptions.iter().all(|exception| !self.selectors.contains(exception)) {
+            return None;
+        }
+        let mut kept: Vec<&str> = self
+            .selectors
+            .iter()
+            .filter(|selector| !exceptions.contains(*selector))
+            .map(String::as_str)
