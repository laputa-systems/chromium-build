+    /// Returns every generic class and id hide selector, so an embedder can apply them all as one
+    /// stylesheet instead of reporting the classes and ids each page uses. Hostname exceptions are
+    /// not applied; they are in each page's `UrlSpecificResources`.
+    pub fn generic_class_id_selectors(&self) -> Vec<String> {
+        let cosmetic_filters = self.filter_data_context.memory.root().cosmetic_filters();
+        let classes = cosmetic_filters
+            .simple_class_rules()
+            .iter()
+            .filter(|class| !class.is_empty())
+            .map(|class| format!(".{class}"));
+        let ids = cosmetic_filters
+            .simple_id_rules()
+            .iter()
+            .filter(|id| !id.is_empty())
+            .map(|id| format!("#{id}"));
+        let complex = cosmetic_filters
+            .complex_class_rules_values()
+            .iter()
+            .chain(cosmetic_filters.complex_id_rules_values().iter())
+            .flat_map(|values| values.data().iter())
+            .filter(|selector| !selector.is_empty())
+            .map(str::to_owned);
+        classes.chain(ids).chain(complex).collect()
+    }
+
