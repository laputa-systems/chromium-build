+  testing::StrictMock<MockHidManagerClient> client;
+  mojo::PendingAssociatedRemote<mojom::HidManagerClient> client_remote;
+  client.Bind(client_remote.InitWithNewEndpointAndPassReceiver());
+
+  {
+    base::RunLoop loop;
+    manager->GetDevicesAndSetClient(
+        std::move(client_remote),
+        base::BindLambdaForTesting(
+            [&](std::vector<mojom::HidDeviceInfoPtr> devices) {
+              EXPECT_TRUE(devices.empty());
+              loop.Quit();
+            }));
+    loop.Run();
+  }
+  {
+    base::RunLoop loop;
+    manager->Connect(
+        "missing-device", mojo::NullRemote(), mojo::NullRemote(), false, false,
+        base::BindLambdaForTesting(
+            [&](mojo::PendingRemote<mojom::HidConnection> connection) {
+              EXPECT_FALSE(connection.is_valid());
+              loop.Quit();
+            }));
+    loop.Run();
+  }
+  {
+    base::RunLoop loop;
+    manager->GetDevices(base::BindLambdaForTesting(
+        [&](std::vector<mojom::HidDeviceInfoPtr> devices) {
+          EXPECT_TRUE(devices.empty());
+          loop.Quit();
+        }));
+    loop.Run();
+  }
+  EXPECT_TRUE(manager.is_connected());
+}
