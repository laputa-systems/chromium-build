+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/platform_util.h"
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/process/kill.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "chrome/browser/platform_util_internal.h"
+#include "url/gurl.h"
+
+namespace {
+
+void Launch(const std::string& program, const std::string& argument) {
+  base::LaunchOptions options;
+  options.allow_new_privs = true;
+  base::Process process = base::LaunchProcess({program, argument}, options);
+  if (process.IsValid()) {
+    base::EnsureProcessGetsReaped(std::move(process));
+  }
+}
+
+}  // namespace
+
+namespace platform_util {
+
+namespace internal {
+
+void PlatformOpenVerifiedItem(const base::FilePath& path, OpenItemType) {
+  Launch("xdg-open", path.value());
+}
+
+}  // namespace internal
+
+void ShowItemInFolder(Profile*, const base::FilePath& full_path) {
+  Launch("xdg-open", full_path.DirName().value());
+}
+
+void OpenExternal(const GURL& url) {
+  if (url.SchemeIs("mailto")) {
+    Launch("xdg-email", url.spec());
+  } else {
+    Launch("xdg-open", url.spec());
+  }
+}
+
+}  // namespace platform_util
