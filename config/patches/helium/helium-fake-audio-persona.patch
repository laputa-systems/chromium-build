+#if defined(__aarch64__)
+FakeAudioManager::Persona FakeAudioManager::GetPersona() const {
+  Persona persona;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kPersonaSwitch)) {
+    return persona;
+  }
+  const std::string value =
+      command_line->GetSwitchValueASCII(kPersonaSwitch);
+  for (const std::string& part : base::SplitString(
+           value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const auto equals = part.find('=');
+    if (equals == std::string::npos) {
+      continue;
+    }
+    const std::string key(base::TrimWhitespaceASCII(
+        std::string_view(part).substr(0, equals), base::TRIM_ALL));
+    const std::string field(base::TrimWhitespaceASCII(
+        std::string_view(part).substr(equals + 1), base::TRIM_ALL));
+    if (key == "sample_rate") {
+      persona.sample_rate =
+          ParsePositiveInt(field, persona.sample_rate);
+    } else if (key == "frames_per_buffer") {
+      persona.frames_per_buffer =
+          ParsePositiveInt(field, persona.frames_per_buffer);
+    } else if (key == "max_channel_count") {
+      persona.max_channel_count =
+          ParsePositiveInt(field, persona.max_channel_count);
+    } else if (key == "output_devices") {
+      const int parsed = ParsePositiveInt(field, -1);
+      persona.output_devices = parsed >= 0 ? parsed : persona.output_devices;
+      if (field == "0") {
+        persona.output_devices = 0;
+      }
+    } else if (key == "input_devices") {
+      const int parsed = ParsePositiveInt(field, -1);
+      persona.input_devices = parsed >= 0 ? parsed : persona.input_devices;
+      if (field == "0") {
+        persona.input_devices = 0;
+      }
+    }
+  }
+  if (persona.max_channel_count < 1) {
+    persona.max_channel_count = 1;
+  }
+  if (persona.max_channel_count > 8) {
+    persona.max_channel_count = 8;
+  }
+  if (persona.output_devices < 0) {
+    persona.output_devices = 0;
+  }
+  if (persona.input_devices < 0) {
+    persona.input_devices = 0;
+  }
+  return persona;
+}
+#else
+FakeAudioManager::Persona FakeAudioManager::GetPersona() const {
+  return Persona();
+}
+#endif
