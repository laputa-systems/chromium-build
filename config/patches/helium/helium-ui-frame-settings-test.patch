+TEST_F(CompositorTestWithMessageLoop, DisableFrameRateLimitSetting) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      switches::kDisableFrameRateLimit);
+  DestroyCompositor();
+  CreateCompositor();
+  EXPECT_FALSE(compositor()->GetLayerTreeSettings().disable_frame_rate_limit);
+
+  command_line.GetProcessCommandLine()->AppendSwitch(
+      switches::kDisableFrameRateLimit);
+  DestroyCompositor();
+  CreateCompositor();
+  EXPECT_TRUE(compositor()->GetLayerTreeSettings().disable_frame_rate_limit);
+}
 
