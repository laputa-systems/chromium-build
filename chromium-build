#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLATFORM=linux
ARCH=
PROFILE=
IMAGE=${CHROMIUM_BUILDER_IMAGE:-}
WORK_VOLUME=${CHROMIUM_WORK_VOLUME:-}
CACHE_VOLUME=${CHROMIUM_CACHE_VOLUME:-}
APP_PATH=
HEADED_REFERENCE=
INSTALL_PREFIX=${CHROMIUM_INSTALL_PREFIX:-}
INSTALL_BIN_DIR=${CHROMIUM_INSTALL_BIN_DIR:-}
JOBS=
YES=0
LATEST=0

fail() {
    echo "chromium-build: $*" >&2
    exit 1
}

usage() {
    printf '%s\n' \
        'usage: chromium-build [--platform linux|macos] [--arch arm64|amd64] [--profile PROFILE] command' \
        '       chromium-build image [--arch amd64]' \
        '       chromium-build ensure-source|fetch|prepare|gate-a|gate-b|gate-c|gate-d|gate-e|gate-f|poc|build|cache-stats|stage-runtime|test-fast|test|test-staged|package [--arch amd64] [--profile headless-debug|headless-release] [--jobs N]' \
        '       chromium-build install [--profile headless-debug|headless-release] [--prefix DIR] [--bin-dir DIR]' \
        '       chromium-build build-target <ninja-output-or-label> [--arch amd64] [--jobs N]' \
        '       chromium-build --platform macos doctor|smoke-preflight|update-lock|fetch|prepare|configure|build|cache-stats|stage-runtime|package|verify-release|test-staged [--arch arm64]' \
        '       chromium-build --platform macos test-staged [--headed-reference OBSERVATIONS.json]'
}

command_name=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --platform)
            [ "$#" -ge 2 ] || fail '--platform needs a value'
            PLATFORM=$2
            shift 2
            ;;
        --arch)
            [ "$#" -ge 2 ] || fail '--arch needs a value'
            ARCH=$2
            shift 2
            ;;
        --profile)
            [ "$#" -ge 2 ] || fail '--profile needs a value'
            PROFILE=$2
            shift 2
            ;;
        --app)
            [ "$#" -ge 2 ] || fail '--app needs a value'
            APP_PATH=$2
            shift 2
            ;;
        --headed-reference)
            [ "$#" -ge 2 ] || fail '--headed-reference needs a report path'
            HEADED_REFERENCE=$2
            shift 2
            ;;
        --prefix)
            [ "$#" -ge 2 ] || fail '--prefix needs a value'
            INSTALL_PREFIX=$2
            shift 2
            ;;
        --bin-dir)
            [ "$#" -ge 2 ] || fail '--bin-dir needs a value'
            INSTALL_BIN_DIR=$2
            shift 2
            ;;
        --jobs)
            [ "$#" -ge 2 ] || fail '--jobs needs a value'
            JOBS=$2
            shift 2
            ;;
        --yes)
            YES=1
            shift
            ;;
        --latest)
            LATEST=1
            shift
            ;;
        image|ensure-source|install|fetch|prepare|gate-a|gate-b|gate-c|gate-d|gate-e|gate-f|poc|build|cache-stats|stage-runtime|package|verify-release|test-fast|test|test-staged|doctor|smoke-preflight|update-lock|configure|reset|status)
            [ -z "$command_name" ] || fail 'only one command may be selected'
            command_name=$1
            shift
            ;;
        build-target)
            [ -z "$command_name" ] || fail 'only one command may be selected'
            command_name=$1
            shift
            [ "$#" -gt 0 ] || fail 'build-target needs an output or label'
            BUILD_TARGET=$1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "unknown argument $1"
            ;;
    esac
done
[ -n "$command_name" ] || { usage >&2; exit 2; }
[ -n "$ARCH" ] || {
    if [ "$PLATFORM" = macos ]; then ARCH=arm64; else ARCH=amd64; fi
}
case "$ARCH" in
    aarch64) ARCH=arm64 ;;
    arm64|amd64) ;;
    *) fail "unsupported architecture $ARCH" ;;
esac
case "$PLATFORM" in
    macos)
        [ "$ARCH" = arm64 ] || fail 'macOS supports native arm64 only'
        PROFILE=${PROFILE:-macos-release}
        [ "$PROFILE" = macos-release ] || fail 'macOS supports the macos-release profile only'
        native_args=(--repo-root "$ROOT" --platform macos --arch "$ARCH" --profile "$PROFILE" --command "$command_name")
        [ "$YES" = 1 ] && native_args+=(--yes)
        [ "$LATEST" = 1 ] && native_args+=(--latest)
        [ -n "$APP_PATH" ] && native_args+=(--app "$APP_PATH")
        [ -n "$HEADED_REFERENCE" ] && native_args+=(--headed-reference "$HEADED_REFERENCE")
        [ -n "$JOBS" ] && native_args+=(--jobs "$JOBS")
        if [ "$command_name" = build-target ]; then
            fail 'build-target is currently Linux-only; use macOS build to produce the release target'
        fi
        exec "${CHROMIUM_PYTHON:-python3}" "$ROOT/scripts/macos_backend.py" "${native_args[@]}"
        ;;
    linux)
        [ -z "$HEADED_REFERENCE" ] || fail '--headed-reference is macOS-only'
        PROFILE=${PROFILE:-headless-debug}
        case "$PROFILE" in
            headless-debug|headless-release) ;;
            *) fail "Linux supports the headless-debug and headless-release profiles only" ;;
        esac
        ;;
    *)
        fail "unsupported platform $PLATFORM"
        ;;
esac

case "$ARCH" in
    amd64)
        platform=linux/amd64
        base_image=alpine@sha256:79ff19e9084a00eece421b2523fb93e22d730e2c0e525905de047e848e56d95f
        llvm_url=https://commondatastorage.googleapis.com/chromium-browser-clang/Linux_x64/clang-llvmorg-24-init-3796-g20e97c4b-2.tar.xz
        llvm_sha256=86d53b33007a35695645e3867589a20f6f8aeedd146331e1a2ec8fd371e05ea2
        llvm_size=59131228
        ;;
    arm64) fail 'Chromium 153 publishes no native Linux arm64 LLVM 24 archive; the Linux backend currently supports amd64 only' ;;
esac

IMAGE=${IMAGE:-ungoogled-chromium-builder:153.0.8010.52-$ARCH}
WORK_VOLUME=${WORK_VOLUME:-ungoogled-chromium-153-work-$ARCH}
CACHE_VOLUME=${CACHE_VOLUME:-ungoogled-chromium-153-ccache-$ARCH}

native_arch=$(docker info --format '{{.Architecture}}' 2>/dev/null || true)
case "$native_arch" in
    aarch64|arm64) native_arch=arm64 ;;
    x86_64|amd64) native_arch=amd64 ;;
esac
[ "$native_arch" = "$ARCH" ] || fail "requested $ARCH is not the native Docker architecture ($native_arch)"

if [ "$command_name" = image ]; then
    docker build --platform "$platform" \
        --build-arg TARGET_ARCH="$ARCH" \
        --build-arg BASE_IMAGE="$base_image" \
        --build-arg LLVM_URL="$llvm_url" \
        --build-arg LLVM_SHA256="$llvm_sha256" \
        --build-arg LLVM_SIZE="$llvm_size" \
        -t "$IMAGE" "$ROOT"
    docker image inspect "$IMAGE" --format 'image={{.Id}}'
    exit 0
fi

docker image inspect "$IMAGE" >/dev/null 2>&1 || fail "missing $IMAGE; run chromium-build image first"
docker volume create "$WORK_VOLUME" >/dev/null
docker volume create "$CACHE_VOLUME" >/dev/null
image_digest=$(docker image inspect "$IMAGE" --format '{{.Id}}')

run_fetch() {
    docker run --rm --network=bridge \
        -e NETWORK_MODE=fetch \
        -e CHROMIUM_ARCH="$ARCH" \
        -e CHROMIUM_PROFILE="$PROFILE" \
        -e CHROMIUM_METADATA_ROOT=/work/metadata \
        -v "$WORK_VOLUME:/work" \
        "$IMAGE" python3 /opt/chromium-build/scripts/fetch-inputs.py
}

run_gate() {
    local gate=$1
    shift
    local -a browser_resources=()
    if [ "$gate" = test-fast-driver.py ] || [ "$gate" = test-functional-driver.py ]; then
        browser_resources+=(--privileged)
        browser_resources+=(--tmpfs /dev/shm:rw,nosuid,nodev,noexec,size=1g)
        browser_resources+=(--tmpfs /tmp:rw,nosuid,nodev,size=256m)
    fi
    local script_command=("/opt/chromium-build/scripts/$gate")
    case "$gate" in
        *.py) script_command=(python3 "${script_command[0]}") ;;
    esac
    local -a test_environment=()
    local -a build_environment=()
    if [ -n "$JOBS" ]; then
        build_environment+=(-e "JOBS=$JOBS")
    fi
    build_environment+=(-e "GN_OUT=/work/out/$PROFILE")
    if [ "$command_name" = test-staged ]; then
        test_environment+=(-e "CHROMIUM_TEST_CHROME=/work/stage/$PROFILE/chrome")
        test_environment+=(-e "MEDIA_RUNTIME_BASELINE=/work/metadata/media-runtime-baseline.json")
    fi
    docker run --rm --network=none ${browser_resources[@]+"${browser_resources[@]}"} \
        -e CHROMIUM_ARCH="$ARCH" \
        -e CHROMIUM_PROFILE="$PROFILE" \
        -e BUILDER_IMAGE_DIGEST="$image_digest" \
        -e CHROMIUM_METADATA_ROOT=/work/metadata \
        -e APK_MANIFEST="/opt/chromium-build-metadata/packages.$ARCH.txt" \
        -e ENVIRONMENT_METADATA="/opt/chromium-build-metadata/environment.json" \
        -e SYSTEM_LIBRARY_PREFLIGHT="/opt/chromium-build-metadata/system-library-preflight.json" \
        -e EGL_PLATFORM=surfaceless \
        -e CCACHE_VOLUME="$CACHE_VOLUME" \
        ${test_environment[@]+"${test_environment[@]}"} \
        ${build_environment[@]+"${build_environment[@]}"} \
        -v "$WORK_VOLUME:/work" \
        -v "$CACHE_VOLUME:/ccache" \
        "$IMAGE" "${script_command[@]}" "$@"
}

volume_has() {
    docker run --rm --network=none -v "$WORK_VOLUME:/work:ro" "$IMAGE" test -e "/work/$1"
}

# Fetch and prepare are one-shot: prepare refuses to overwrite a prepared
# source tree, so a resumable release run skips whatever already completed.
ensure_source() {
    if volume_has metadata/fetch-complete.stamp; then
        echo 'ensure-source: fetch already complete'
    else
        run_fetch
    fi
    if volume_has metadata/source-complete.stamp; then
        echo 'ensure-source: source already prepared'
    else
        run_gate prepare-source-driver.py
    fi
}

# Launch the way CDP clients such as Shadowdriver do, with a scrubbed
# environment, and require the DevTools endpoint to create a page target.
smoke_cdp() {
    local launcher=$1 profile_dir pid port i status=1
    profile_dir=$(mktemp -d)
    env -i HOME="$HOME" PATH=/usr/bin:/bin "$launcher" --headless=new --disable-gpu --no-first-run \
        --remote-debugging-port=0 --user-data-dir="$profile_dir" about:blank 2>"$profile_dir.log" &
    pid=$!
    for i in $(seq 60); do
        [ -s "$profile_dir/DevToolsActivePort" ] && break
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    port=$(head -n 1 "$profile_dir/DevToolsActivePort" 2>/dev/null || true)
    if [ -n "$port" ] \
        && curl -fsS "http://127.0.0.1:$port/json/version" | grep -q '"Browser": *"[A-Za-z]*Chrome/' \
        && curl -fsS -X PUT "http://127.0.0.1:$port/json/new?about:blank" | grep -q '"type": *"page"'; then
        status=0
    fi
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    [ "$status" = 0 ] || tail -20 "$profile_dir.log" >&2
    rm -rf -- "$profile_dir" "$profile_dir.log"
    return "$status"
}

# Copy the packaged bundle out of the work volume, verify it byte-for-byte
# against its manifest, prove it launches on this host, then swap it in.
install_package() {
    [ -n "${HOME:-}" ] || fail 'install needs HOME or --prefix and --bin-dir'
    local prefix=${INSTALL_PREFIX:-$HOME/.local/opt/ungoogled-chromium-$PROFILE}
    local bin_dir=${INSTALL_BIN_DIR:-$HOME/.local/bin}
    case "$prefix" in /*) ;; *) fail "--prefix must be absolute: $prefix" ;; esac
    volume_has "package/$PROFILE/package-manifest.json" || fail "no $PROFILE package; run chromium-build package first"
    mkdir -p "$(dirname -- "$prefix")" "$bin_dir"
    local staging
    staging=$(mktemp -d "$(dirname -- "$prefix")/.chromium-install.XXXXXX")
    trap 'rm -rf -- "$staging"' EXIT
    docker run --rm --network=none \
        -v "$WORK_VOLUME:/work:ro" \
        -v "$staging:/install" \
        "$IMAGE" python3 -c '
import hashlib, json, os, shutil, sys
source, target, owner = sys.argv[1], "/install", (int(sys.argv[2]), int(sys.argv[3]))
manifest = json.load(open(os.path.join(source, "package-manifest.json")))
if manifest.get("status") != "complete":
    sys.exit("package manifest is incomplete")
shutil.copytree(source, target, dirs_exist_ok=True)
for entry in manifest["files"]:
    with open(os.path.join(target, entry["path"]), "rb") as stream:
        if hashlib.file_digest(stream, "sha256").hexdigest() != entry["sha256"]:
            sys.exit(f"installed file differs from the package: {entry["path"]}")
for directory, names, files in os.walk(target):
    for name in [directory, *(os.path.join(directory, file) for file in files)]:
        os.chown(name, *owner)
' "/work/package/$PROFILE" "$(id -u)" "$(id -g)"
    smoke_cdp "$staging/chromium" || fail 'packaged Chromium did not start and open a page on this host'
    if [ -e "$prefix" ]; then
        mv -- "$prefix" "$staging.previous"
    fi
    mv -- "$staging" "$prefix"
    trap - EXIT
    rm -rf -- "$staging.previous"
    ln -sfn -- "$prefix/chromium" "$bin_dir/chromium"
    echo "install: $("$bin_dir/chromium" --version) at $prefix"
    echo "install: $bin_dir/chromium -> $prefix/chromium"
}

case "$command_name" in
    fetch) run_fetch ;;
    prepare) run_gate prepare-source-driver.py ;;
    gate-a) run_gate verify-environment.py ;;
    gate-b) run_gate run-probes.py ;;
    gate-c) run_gate verify-source.py ;;
    gate-d) run_gate generate-gn.py ;;
    gate-e) run_gate run-gate-e.py ;;
    gate-f) run_gate audit-chrome-graph-driver.py ;;
    build) run_gate build.py ;;
    build-target) run_gate build-target.py "$BUILD_TARGET" ;;
    cache-stats)
        docker run --rm --network=none -v "$CACHE_VOLUME:/ccache" "$IMAGE" ccache --show-stats
        ;;
    stage-runtime) run_gate stage-runtime.py --chrome "/work/out/$PROFILE/chrome" --output "/work/stage/$PROFILE" ;;
    package) run_gate package-runtime.py --stage "/work/stage/$PROFILE" --output "/work/package/$PROFILE" ;;
    ensure-source) ensure_source ;;
    install) install_package ;;
    test-fast) run_gate test-fast-driver.py ;;
    test) run_gate test-functional-driver.py ;;
    test-staged) run_gate test-functional-driver.py ;;
    poc)
        run_gate verify-environment.py
        run_gate run-probes.py
        run_gate verify-source.py
        run_gate generate-gn.py
        run_gate run-gate-e.py
        run_gate audit-chrome-graph-driver.py
        ;;
esac
